{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start MathOntoSpeak",
      "type": "shell",
      "command": "${workspaceFolder}\\Start-MathOntoSpeak.cmd",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Check MathOntoSpeak services",
      "type": "shell",
      "command": "${workspaceFolder}\\Start-MathOntoSpeak.cmd",
      "args": ["--check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
